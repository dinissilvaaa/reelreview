# -----------------------------------------------------------------------------
# Backend environment variables (example).
# Copy this file to ".env" (same folder) and adjust the values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# The real .env file is ignored by Git, so secrets never reach GitHub.
# -----------------------------------------------------------------------------

# Mode the server runs in: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
#  - Local MongoDB or "docker compose up -d mongo":  mongodb://127.0.0.1:27017/reelreview
#  - MongoDB Atlas (cloud):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reelreview
MONGO_URI=mongodb://127.0.0.1:27017/reelreview

# Secret used to sign JWT login tokens. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# How long a login token stays valid (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS (comma separated if more than one)
CLIENT_URL=http://localhost:5173

# Set to "true" when the API runs behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=false

# When "true", the database is filled with demo movies/users on startup if it is empty
SEED_ON_START=true

# Credentials of the admin account created by the seed script
ADMIN_EMAIL=admin@reelreview.com
ADMIN_PASSWORD=Admin123!
