# -----------------------------------------------------------------------------
# OPTIONAL settings for "docker compose up".
# Copy this file to ".env" (in this same root folder) to override the defaults
# defined in docker-compose.yml. Without a .env file the defaults are used.
# -----------------------------------------------------------------------------

# Secret used to sign login tokens - use a long random value for real deployments
JWT_SECRET=replace-me-with-a-long-random-secret

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Admin account created automatically on the first start
ADMIN_EMAIL=admin@reelreview.com
ADMIN_PASSWORD=Admin123!
