# -----------------------------------------------------------------------------
# Frontend environment variables (example). Copy to ".env" only if you need them.
# Variables must start with VITE_ to be visible in the browser code.
# -----------------------------------------------------------------------------

# Leave EMPTY when the frontend and backend share the same origin, which is the
# case for "npm run dev" (Vite proxy) and for Docker (nginx proxy).
# Set it only if the API is hosted on another domain, e.g. https://reelreview-api.onrender.com
VITE_API_URL=

# Where the Vite dev server forwards /api and /uploads requests (development only)
VITE_PROXY_TARGET=http://localhost:5000
